# ============================================================
# Plantilla de variables de entorno. Copia a .env.local y rellena.
#   cp .env.example .env.local
# Todas las variables son opcionales; sin ellas la app corre con
# el render local en canvas y el muro deshabilitado.
# ============================================================

# --- Event gate -----------------------------------------------------
# ISO-8601 de cuando se "abre" el evento.
# Default: 2026-08-29T00:00:00-05:00
NEXT_PUBLIC_EVENT_UNLOCK_AT=2026-08-29T00:00:00-05:00

# --- Marca del evento (opcional) ----------------------------------
# El tema activo se lee de Supabase (tabla brand_themes, editable en /marca).
# Estas variables son el fallback cuando Supabase no esta configurado.
# Preset base: platzi | joropofest
NEXT_PUBLIC_BRAND_PRESET=platzi
NEXT_PUBLIC_BRAND_EVENT_NAME=
NEXT_PUBLIC_BRAND_CARD_TITLE=
NEXT_PUBLIC_BRAND_EVENT_DATE_LABEL=
NEXT_PUBLIC_BRAND_HERO_TITLE=
NEXT_PUBLIC_BRAND_HERO_SUBTITLE=
NEXT_PUBLIC_BRAND_LOCKED_TITLE=
NEXT_PUBLIC_BRAND_WALL_TITLE=
NEXT_PUBLIC_BRAND_QR_IMAGE=
NEXT_PUBLIC_BRAND_DOWNLOAD_FILE_NAME=
NEXT_PUBLIC_BRAND_CARD_STYLE=
NEXT_PUBLIC_BRAND_ART_STYLE_LABEL=
NEXT_PUBLIC_BRAND_AI_STYLE=
NEXT_PUBLIC_BRAND_AI_PALETTE=
NEXT_PUBLIC_BRAND_FRAME_IMAGE=
NEXT_PUBLIC_BRAND_FRAME_ASPECT=
NEXT_PUBLIC_BRAND_FRAME_RADIUS=
# x,y,ancho,alto del recuadro de la foto dentro de la portada (0-1)
NEXT_PUBLIC_BRAND_FRAME_AREA=
NEXT_PUBLIC_BRAND_COLOR_PRIMARY=
NEXT_PUBLIC_BRAND_COLOR_INK=
NEXT_PUBLIC_BRAND_COLOR_LIGHT=
NEXT_PUBLIC_BRAND_COLOR_MUTED=
NEXT_PUBLIC_BRAND_CREDIT_NAME=
NEXT_PUBLIC_BRAND_CREDIT_URL=
NEXT_PUBLIC_BRAND_CREDIT_MESSAGE=

# Opcional: protege PUT /api/brand y el guardado desde /marca.
BRAND_ADMIN_TOKEN=

# --- Supabase (requerido solo para /muro) --------------------------
# supabase.com -> tu proyecto -> Project Settings -> API Keys
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_anon_o_publishable_key

# Opcional: solo si insertas en el muro con bypass de RLS desde el server.
# NUNCA la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nombre del bucket de storage. Default: wall-images
SUPABASE_WALL_BUCKET=wall-images

# --- Generacion con IA (opcional) ---------------------------------
# La app intenta Stability AI primero, luego Vercel AI Gateway y por ultimo OpenAI.

# Opcion A: Stability AI
STABILITY_API_KEY=
STABILITY_ENDPOINT=https://api.stability.ai/v2beta/stable-image/control/structure
STABILITY_CONTROL_STRENGTH=0.75
STABILITY_STYLE_PRESET=

# Opcion B: Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_IMAGE_MODEL=google/gemini-3-pro-image
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Opcion C: OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
