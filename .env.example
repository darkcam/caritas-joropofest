# ============================================================
# Plantilla de variables de entorno. Copia a .env.local y rellena.
#   cp .env.example .env.local
# Todas las variables son opcionales; sin ellas la app corre con
# el render local en canvas y el muro deshabilitado.
# ============================================================

# --- Event gate -----------------------------------------------------
# ISO-8601 de cuando se "abre" el evento.
# Default: 2026-08-29T00:00:00-05:00
NEXT_PUBLIC_EVENT_UNLOCK_AT=2026-08-29T00:00:00-05:00

# --- Supabase (requerido solo para /muro) --------------------------
# supabase.com -> tu proyecto -> Project Settings -> API Keys
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_anon_o_publishable_key

# Opcional: solo si insertas en el muro con bypass de RLS desde el server.
# NUNCA la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nombre del bucket de storage. Default: wall-images
SUPABASE_WALL_BUCKET=wall-images

# --- Generacion con IA (opcional) ---------------------------------
# La app intenta Vercel AI Gateway primero, luego OpenAI.

# Opcion A: Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_IMAGE_MODEL=google/gemini-3-pro-image
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Opcion B: OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
